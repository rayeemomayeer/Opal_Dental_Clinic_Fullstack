{
  "name": "opal-dental",
  "private": true,
  "version": "0.1.0",
  "description": "Opal Dental Clinic & Implant Centre — premium, animated, fullstack website.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @opal/api db:generate",
    "db:migrate": "pnpm --filter @opal/api db:migrate",
    "db:studio": "pnpm --filter @opal/api db:studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opal?schema=public"

# --- Cloudinary (server-side: signing uploads, transformations) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
